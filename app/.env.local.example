# Bearings — Local Development Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# Firebase config as base64-encoded valid JSON (double-quoted keys).
# To encode: echo '{"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}' | base64
VITE_FIREBASE_CONFIG=your_base64_encoded_firebase_config_json_here

# Mapbox public token (scoped to localhost for local dev)
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Google Analytics 4 Measurement ID (optional for local dev)
VITE_GA_ID=G-XXXXXXXXXX
